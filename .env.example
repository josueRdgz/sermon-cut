# Copy this file to ".env" (in the repository root) and adjust as needed.
# All backend variables are prefixed with SERMON_CUT_.
# Never commit a real .env (API keys, local paths with secrets, etc.).

# Human-readable application name.
SERMON_CUT_APP_NAME="Sermon Cut"

# API path prefix.
SERMON_CUT_API_PREFIX="/api"

# ---- Storage (configurable) ----
# Directory for SQLite, uploads, renders, temp files and Whisper cache.
# Absolute path recommended on Windows. Default: <repo>/storage
# SERMON_CUT_STORAGE_DIR="/absolute/path/to/sermon-cut-storage"

# SQLAlchemy database URL. Defaults to SQLite inside the storage dir.
# Example: sqlite:////absolute/path/to/storage/sermon_cut.db
# SERMON_CUT_DATABASE_URL="sqlite:///./storage/sermon_cut.db"
# Ruta opcional. En macOS se prefiere automáticamente ffmpeg-full si está instalado.
# SERMON_CUT_FFMPEG_PATH="/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg"

# Apply Alembic migrations when the API starts (failures are logged, not fatal).
SERMON_CUT_AUTO_MIGRATE=true

# Optional development-only autoreload for scripts/start-backend.*.
# Disabled by default because restarting FastAPI interrupts in-process jobs.
# When enabled, the watcher is limited to backend/app/ and excludes .venv.
# SERMON_CUT_RELOAD=true

# Allowed CORS origins (JSON array). Vite + Tauri webview origins by default.
SERMON_CUT_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","tauri://localhost","https://tauri.localhost","http://tauri.localhost","https://asset.localhost","http://asset.localhost"]'

# Maximum size (bytes) for a single uploaded *video*. Default: 4 GiB.
SERMON_CUT_MAX_UPLOAD_BYTES=4294967296
# Covers / logos (default 20 MiB) and music beds (default 100 MiB).
# SERMON_CUT_MAX_COVER_UPLOAD_BYTES=20971520
# SERMON_CUT_MAX_MUSIC_UPLOAD_BYTES=104857600

# ---- Local transcription (faster-whisper) ----
# Default model: tiny | base | small | medium | large-v3.
# "small" is a good balance for modest machines; "medium" for higher quality.
SERMON_CUT_WHISPER_MODEL="small"

# Device preference: auto | cuda | cpu.
# "auto" uses CUDA when available, otherwise CPU. On Apple Silicon it always
# runs on CPU (Metal/GPU is not supported by CTranslate2/faster-whisper).
SERMON_CUT_WHISPER_DEVICE="auto"

# CTranslate2 compute type: auto | int8 | int8_float16 | float16 | float32.
# "auto" -> float16 on CUDA, int8 on CPU.
SERMON_CUT_WHISPER_COMPUTE_TYPE="auto"

# Keep the extracted temporary WAV for debugging instead of deleting it.
SERMON_CUT_KEEP_TEMP_AUDIO=false

# Minimum duration (seconds) of a single Reel segment.
SERMON_CUT_MIN_REEL_SEGMENT_SECONDS=0.1

# ---- Optional AI analysis (Gemini) ----
# The app works fully without Gemini. When no key is set, analysis uses a
# deterministic mock provider so the UI and validation path stay exercisable.
# "auto" | "mock" | "gemini"
SERMON_CUT_AI_PROVIDER="auto"

# Gemini API key — set only in your local .env or OS keychain. Never commit it.
# SERMON_CUT_GEMINI_API_KEY="your-key-here"

# Model id for the official google-genai SDK (structured JSON output).
SERMON_CUT_GEMINI_MODEL="gemini-2.5-flash"

# Request timeout (seconds) and bounded retries for transient errors only.
SERMON_CUT_GEMINI_TIMEOUT_SECONDS=90
SERMON_CUT_GEMINI_MAX_ATTEMPTS=3

# Approximate character budget per transcript chunk before calling the model.
SERMON_CUT_AI_CHUNK_CHAR_LIMIT=48000

# Editorial pacing for suggested Reels. Prefer long continuous passages and
# allow at most 3 source fragments (cuts) per Reel.
SERMON_CUT_AI_MAX_SEGMENTS_PER_REEL=3
SERMON_CUT_AI_MIN_SEGMENT_SECONDS=8
# Consecutive suggestions separated by no more than this are merged into one.
SERMON_CUT_AI_MERGE_GAP_SECONDS=1.25

# ---- Loudness (spoken-word friendly) ----
SERMON_CUT_TARGET_LUFS=-16.0
SERMON_CUT_TRUE_PEAK_DB=-1.5
SERMON_CUT_LOUDNESS_LRA=11.0

# ---- Optional YouTube import (yt-dlp) ----
# Local file upload is always the primary, stable method. This is opt-in and
# requires the external `yt-dlp` executable (pip install -U yt-dlp) + FFmpeg.
# Import ONLY videos you own or are authorized to use.
SERMON_CUT_YOUTUBE_IMPORT_ENABLED=true

# Explicit path to yt-dlp. Leave empty to resolve it on PATH.
# SERMON_CUT_YTDLP_PATH="/usr/local/bin/yt-dlp"

# Default download quality: "720p" | "1080p" | "best". Never 4K by default.
SERMON_CUT_YOUTUBE_DEFAULT_QUALITY="1080p"

# Reject videos longer than this many seconds (default: 4 hours).
SERMON_CUT_YOUTUBE_MAX_DURATION_SECONDS=14400

# Refuse to start if the estimated download exceeds this size (default 8 GiB).
SERMON_CUT_YOUTUBE_MAX_ESTIMATED_BYTES=8589934592

# Require at least this much free disk beyond the estimate (default 1 GiB).
SERMON_CUT_YOUTUBE_MIN_FREE_BYTES=1073741824

# Timeout (seconds) for the metadata / preview step.
SERMON_CUT_YOUTUBE_METADATA_TIMEOUT_SECONDS=60

# ---- Frontend (Vite) ----
# Optional: override the backend base URL. Leave empty to use the dev proxy.
# VITE_API_BASE_URL="http://127.0.0.1:8000"
